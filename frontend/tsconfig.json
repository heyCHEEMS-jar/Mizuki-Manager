{
	"compilerOptions": {
		"types": [
			"react",
			"react-dom"
		],
		"jsx": "react-jsx",
		"target": "esnext",
		"module": "esnext",
		"lib": [
			"DOM",
			"DOM.Iterable",
			"ESNext"
		],
		"allowJs": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"moduleResolution": "bundler",
		"ignoreDeprecations": "6.0",
		"baseUrl": ".",
		"paths": {
			"@/*": [
				"src/*"
			]
		}
	},
	"include": [
		"src/**/*"
	],
	"exclude": [
		"node_modules",
		"dist",
		"build",
		"public"
	]
}